# --- Roblox place files -------------------------------------------------
# The world (Workspace, Terrain, models built in Studio) lives in the place
# file, not in Git. Back it up with File > Save to Roblox (version history)
# and/or a local copy in PlaceBackups/. See README.md "Backing up the world".
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock
PlaceBackups/

# --- Generated by tools -------------------------------------------------
# Output of `rojo build` (used only as a validation check)
/build/
# Generated by `rojo sourcemap` for editor tooling, if we add it later
sourcemap.json

# --- Temporary files ----------------------------------------------------
*.tmp
*.temp
*.bak
*~
*.swp
*.log

# --- OS / editor clutter ------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/

# --- Secrets and credentials (never commit) -----------------------------
.env
.env.*
*.pem
*.key
*.pfx
# Tool credential files (Rokit keeps its own in your user folder; this
# guards against a copy ever landing in the project)
auth.toml
.ROBLOSECURITY
.git-credentials
secrets/
